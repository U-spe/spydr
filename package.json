{
  "name": "spydr-web",
  "version": "1.0.0",
  "description": "Spydr web application",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "cv": "node --no-warnings=ExperimentalWarning packages/cv/main.ts",
    "preinstall": "npx only-allow pnpm",
    "start": "node server.js",
    "deploy": "wrangler pages deploy . --project-name spydr",
    "preview": "wrangler pages dev .",
    "scramjet:build": "./cv build",
    "scramjet:dev": "./cv dev"
  },
  "ava": {
    "files": [
      "tests/ci/**/*.js"
    ],
    "verbose": true
  },
  "devDependencies": {
    "@fastify/deepmerge": "^3.2.1",
    "@mercuryworkshop/wisp-js": "0.4.1",
    "@rsdoctor/rspack-plugin": "^1.4.0",
    "@rspack/cli": "^1.5.8",
    "@rspack/core": "^1.5.8",
    "ava": "^6.4.1",
    "chafa-wasm": "^0.3.1",
    "chalk": "^5.6.2",
    "eslint": "^10.2.0",
    "glob": "^13.0.6",
    "rspack-merge": "^1.0.1",
    "ts-checker-rspack-plugin": "^1.1.6",
    "tsc-alias": "^1.8.16",
    "vite": "^7.3.0",
    "wrangler": "4.156.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "prettier": "^3.6.2",
    "@mercuryworkshop/scramjet": "^1.1.0",
    "@nebula-services/bare-server-node": "^2.0.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "esbuild": "0.28.2",
