# Public app metadata. Include /apps/mov in the URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000/apps/mov
NEXT_PUBLIC_SITE_NAME=CineGeek

# Server-only TMDb API Read Access Token. Never prefix this with NEXT_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token

# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_TWITTER=https://x.com
NEXT_PUBLIC_FACEBOOK=https://facebook.com
NEXT_PUBLIC_INSTAGRAM=https://instagram.com
NEXT_PUBLIC_YOUTUBE=https://youtube.com
